# Byte-exact files: the demo ships the built bundle and the CI job asserts it
# matches a fresh build, so line-ending translation must not rewrite it on checkout.
studio/vendor/** -text
engine/dist/** -text

*.png binary
*.zip binary

# Archive-only exclusions. The upstream documentation site is 19 MB of screenshots
# for a library this fork does not document; keeping it in the repository history is
# free, shipping it inside the release archive is not.
documentation export-ignore
documentation/** export-ignore
.codesandbox export-ignore
.codesandbox/** export-ignore
